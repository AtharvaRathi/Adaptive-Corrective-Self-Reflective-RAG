# =============================================================================
# Adaptive Self-Reflective RAG Orchestrator — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# --- LLM Provider (Groq) ---
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...your-key-here...

# --- Web Search (optional) ---
TAVILY_API_KEY=tvly-...your-key-here...

# --- Model Configuration ---
# Groq-hosted models (check https://console.groq.com/docs/models):
# e.g., qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
LLM_MODEL=qwen/qwen3.8-27b
# HuggingFace sentence-transformers model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Document Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval Configuration ---
# Weights must sum to 1.0
RETRIEVER_DENSE_WEIGHT=0.6
RETRIEVER_SPARSE_WEIGHT=0.4
TOP_K_RETRIEVAL=5

# --- CRAG & Self-RAG Loop Control ---
# Maximum retry iterations before forcing web search fallback
MAX_RETRIES=3

# --- Hallucination & Answer Quality Thresholds ---
# (Reserved for future confidence-score-based evaluation)
HALLUCINATION_THRESHOLD=0.7
FAITHFULNESS_THRESHOLD=0.7
